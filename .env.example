# PostgreSQLコンテナの初期化用（postgres公式イメージが初回起動時に使用）
POSTGRES_DB=linkvault
POSTGRES_USER=linkvault
POSTGRES_PASSWORD=linkvault

# backendがブラウザ・Chrome拡張からのリクエストを許可するオリジン
# （カンマ区切りで複数指定可）
CORS_ALLOWED_ORIGIN=http://localhost:5173

# frontendのビルド時に静的ファイルへ埋め込まれるAPI URL。
# ブラウザから見えるURLを指定する（backendのservice nameではない）。
VITE_API_BASE_URL=http://localhost:8080
